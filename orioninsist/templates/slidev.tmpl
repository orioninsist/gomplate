{{- $data := ds "content" -}}
{{- $ratio := "16/9" -}}
{{- with (index $data "aspectRatio") -}}
{{- $ratio = . -}}
{{- end -}}
{{- with (getenv "SLIDEV_RATIO") -}}
{{- $ratio = . -}}
{{- end -}}
{{- if not (or (eq $ratio "16/9") (eq $ratio "9/16")) -}}
{{- fail "aspectRatio must be 16/9 or 9/16" -}}
{{- end }}
---
theme: default
title: {{ index $data "title" | data.ToYAML | strings.TrimSpace }}
aspectRatio: {{ $ratio }}
canvasWidth: {{ if eq $ratio "9/16" }}540{{ else }}980{{ end }}
transition: fade
---

<style global>
.slidev-layout {
  padding: {{ if eq $ratio "9/16" }}32px{{ else }}48px{{ end }};
  font-size: {{ if eq $ratio "9/16" }}28px{{ else }}32px{{ end }};
  line-height: 1.35;
}

.slidev-layout h1 {
  font-size: {{ if eq $ratio "9/16" }}48px{{ else }}60px{{ end }};
  line-height: 1.15;
}

.slidev-layout h2 {
  font-size: {{ if eq $ratio "9/16" }}38px{{ else }}46px{{ end }};
  line-height: 1.2;
}

.slidev-layout p,
.slidev-layout li {
  font-size: inherit;
  line-height: 1.35;
}

.slidev-layout img {
  max-width: 100%;
  max-height: 65%;
  object-fit: contain;
}
</style>

{{- $data := ds "content" -}}
{{- with (index $data "title") }}
# {{ . }}

{{ end }}
{{- with (index $data "description") }}
{{ . }}

{{ end }}
{{- with (index $data "author") }}
**Author:** {{ . }}

{{ end }}
{{- range (index $data "blocks") }}

---

{{ if eq .type "heading" }}
{{- $level := 2 }}
{{- with .level }}{{ $level = . }}{{ end }}
{{ strings.Repeat $level "#" }} {{ .text }}

{{- else if eq .type "paragraph" }}
{{ .text }}

{{- else if eq .type "image" }}
![{{ .alt }}]({{ .url }})

{{- else if eq .type "video" }}
[{{ .title }}]({{ .url }})

{{- else if eq .type "code" }}
~~~{{ .language }}
{{ .content }}
~~~

{{- else if eq .type "mermaid" }}
~~~mermaid
{{ .content }}
~~~

{{- else if eq .type "quote" }}
{{- range (strings.Split "\n" .text) }}
> {{ . }}
{{- end }}

{{- else if eq .type "list" }}
{{- range .items }}
- {{ . }}
{{- end }}

{{- else if eq .type "tasks" }}
{{- range .items }}
- [{{ if .done }}x{{ else }} {{ end }}] {{ .name }}
{{- end }}

{{- else if eq .type "table" }}
|{{ range .headers }} {{ . | strings.ReplaceAll "|" "\\|" }} |{{ end }}
|{{ range .headers }} --- |{{ end }}
{{- range .rows }}
|{{ range . }} {{ . | strings.ReplaceAll "|" "\\|" }} |{{ end }}
{{- end }}

{{- else if eq .type "divider" }}
---

{{- else if eq .type "markdown" }}
{{ .content }}

{{- else if eq .type "alert" }}
> [!{{ .kind }}]
{{- range (strings.Split "\n" .text) }}
> {{ . }}
{{- end }}

{{- else if eq .type "details" }}
<details>
<summary>{{ .summary }}</summary>

{{ .content }}

</details>

{{- end }}
{{ end -}}
